{
  "name": "passive-orm",
  "version": "1.0.0",
  "description": "Lightweight object-relational mapper for mapping flat and joined SQL results into nested JavaScript objects.",
  "keywords": [
    "orm",
    "mapper",
    "sql",
    "knex",
    "join",
    "mapping",
    "lightweight",
    "prefix",
    "nested",
    "database",
    "query-builder",
    "schema",
    "transformation"
  ],
  "author": {
    "name": "ReddishRebel"
  },
  "license": "MIT",
  "homepage": "https://github.com/ReddishRebel/passive-orm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReddishRebel/passive-orm.git"
  },
  "bugs": {
    "url": "https://github.com/ReddishRebel/passive-orm/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "types",
    "index.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:types",
    "test:types": "tsd",
    "test:unit": "node --test",
    "lint:fix": "eslint index.js ./lib --fix",
    "lint:check": "eslint index.js ./lib",
    "prettier:fix": "prettier index.js index.d.ts ./types ./lib  --write",
    "prettier:check": "prettier index.js index.d.ts ./types ./lib  --check",
    "types": "tsc",
    "check": "npm run lint:fix && npm run prettier:fix && npm run types",
    "prepublishOnly": "npm run check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-sort-imports-requires": "^2.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.5.3",
    "tsd": "^0.33.0",
    "typescript": "^5.9.3"
  },
  "tsd": {
    "directory": "tests/types"
  }
}
