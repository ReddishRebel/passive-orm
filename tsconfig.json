{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": false,
    "strictNullChecks": true
  },
  "include": ["./lib", "./types", "index.js", "index.d.ts"],
  "exclude": ["node_modules"]
}
